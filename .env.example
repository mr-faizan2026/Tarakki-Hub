# TarakkiHub web app — environment template.
# Copy to `.env.local` and fill in from the Supabase project dashboard
# (Project Settings → API). Never commit the filled-in file.

# Public, safe to expose in the browser (the anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Bypasses RLS, so it must never reach the browser,
# the extension, or this repo. Used by the /admin routes and credit tooling.
SUPABASE_SERVICE_ROLE_KEY=
