# TarakkiHub web app — environment template.
# Copy to `.env.local` and fill in from the Supabase project dashboard
# (Project Settings → API). Never commit the filled-in file.

# Public, safe to expose in the browser (the anon key is protected by RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET — server only. Bypasses RLS, so it must never reach the browser,
# the extension, or this repo. Used by the /admin routes and credit tooling.
SUPABASE_SERVICE_ROLE_KEY=

# ── Chrome extension control plane (/api/extension/*) ──────────────────────
# OPTIONAL. Comma-separated list of exact origins allowed to call those routes,
# e.g. chrome-extension://abcdefghijklmnopabcdefghijklmnop
#
# Unset (the default) allows any origin, which is safe here: those routes are
# authenticated by a bearer token and read no cookies, so a hostile page calling
# them gets exactly as far as its own Supabase session would. Set it once the
# extension is published and its Web Store id is known — it costs nothing and
# closes the door on a token leaked into another extension.
EXTENSION_ALLOWED_ORIGINS=

# ── Cashfree payment gateway (credit packs) ────────────────────────────────
# From the Cashfree merchant dashboard → Developers → API Keys. Both are
# SECRETS: server-only, never NEXT_PUBLIC_, never in the extension.
#
# Leave them blank and the site still runs — the pricing page renders, and
# checkout answers "payments aren't switched on" instead of erroring. That is
# the intended state until the merchant KYC is approved.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=

# "sandbox" (the default) or "production". Production must be set EXPLICITLY:
# a forgotten variable then means harmless test payments rather than live ones.
# Sandbox and production have DIFFERENT keys — swapping the mode alone is not
# enough.
CASHFREE_MODE=sandbox

# The app's own public origin, used to build Cashfree's return_url and
# notify_url. On Vercel this is inferred from the deployment, so it is only
# needed when running behind a custom domain or a tunnel.
#   Local webhook testing: point this at an ngrok/cloudflared URL, otherwise
#   Cashfree cannot reach localhost and credits settle only via the page's own
#   status poll.
NEXT_PUBLIC_SITE_URL=
