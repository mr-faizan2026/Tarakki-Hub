# TarakkiHub extension — build-time config (Vite inlines VITE_* at build).
# Copy to `.env` and fill in. NONE of these are secrets:
#   - the Supabase URL and ANON key are public by design (safe to ship).
#   - the SERVICE-ROLE key must NEVER appear here or anywhere in the extension.

# Same Supabase project as the web app (web app: NEXT_PUBLIC_SUPABASE_URL).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Where "Upgrade / manage billing" and account links open.
VITE_WEB_APP_URL=https://tarakkihub.com
