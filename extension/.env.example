# TarakkiHub extension — build-time config (Vite inlines VITE_* at build).
# Copy to `.env` and fill in. NONE of these are secrets:
#   - the Supabase URL and ANON key are public by design (safe to ship).
#   - the SERVICE-ROLE key must NEVER appear here or anywhere in the extension.

# Same Supabase project as the web app (web app: NEXT_PUBLIC_SUPABASE_URL).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# The TarakkiHub web app. Two jobs:
#   • where "Upgrade / manage billing" and account links open;
#   • the origin of /api/extension/* — device registration, the licence
#     heartbeat, the remote adapter config, health events and the idempotent
#     credit endpoint (Part 3).
#
# IMPORTANT: this origin must also be in the manifest's host_permissions, and the
# manifest cannot read this file (it is evaluated in Node, and Vite only inlines
# VITE_* into client code). If you point the extension at a different web app,
# update src/manifest.config.ts to match. A dev build additionally permits
# http://localhost:3000, which a production build does not.
VITE_WEB_APP_URL=https://tarakkihub.com

# Keep the autofill "Field scan" developer view in a PRODUCTION build. It is on
# automatically in `npm run dev`, so leave this unset for anything you ship.
# VITE_DEV_TOOLS=true
